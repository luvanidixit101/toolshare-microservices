      "name": "Auth API",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    var data = res.data || res;",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('jwtToken', data.token);",
                  "        pm.environment.set('jwtToken', data.token);",
                  "    }",
                  "    if (data.refreshToken) {",
                  "        pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "        pm.environment.set('refreshToken', data.refreshToken);",
                  "    }",
                  "    var uid = data.userId || data.id;",
                  "    if (uid) {",
                  "        pm.collectionVariables.set('userId', uid);",
                  "        pm.environment.set('userId', uid);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@1234\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
