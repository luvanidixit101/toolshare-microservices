# ToolShare Frontend Environment Variables

# Base URL of the Spring Boot REST API backend
VITE_API_BASE_URL=http://localhost:8080/api

# When "false", the frontend calls the Spring Boot API Gateway.
VITE_USE_MOCK=false

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

